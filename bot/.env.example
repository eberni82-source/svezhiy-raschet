# Токен бота от @BotFather (строка вида 1234567890:AAH...). Никому не показывайте и не публикуйте.
BOT_TOKEN=

# Ваш Telegram ID (узнать: напишите боту @userinfobot). Несколько — через запятую.
# Администраторы получают заявки на пилот и могут делать рассылку /broadcast.
ADMIN_IDS=

# Необязательно:
# DB_PATH=fresh.db
# WEATHER=off      # выключить погоду (если сервер без доступа к api.open-meteo.com)
